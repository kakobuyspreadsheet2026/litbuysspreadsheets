{
  "headers": [
    {
      "source": "/images/(.*)\\.(webp|png|jpg|jpeg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/pl/index.html", "destination": "/pl/", "permanent": true },
    { "source": "/pt/index.html", "destination": "/pt/", "permanent": true },
    { "source": "/es/index.html", "destination": "/es/", "permanent": true },
    { "source": "/de/index.html", "destination": "/de/", "permanent": true }
  ]
}
